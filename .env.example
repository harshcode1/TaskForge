# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=taskforge
DB_PASSWORD=taskforge123
DB_ROOT_PASSWORD=rootpassword

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-secret-in-production-minimum-32-characters
JWT_EXPIRATION=86400000

# ── Mail (for daily task reminders — leave blank to disable) ──────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ── AI features (task descriptions, project summaries) — leave blank to disable ─
OPENAI_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:6060/api
